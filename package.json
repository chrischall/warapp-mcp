{
  "name": "@chrischall/warapp-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.chrischall/warapp-mcp",
  "description": "war.app (Warzone) game advisor MCP server for Claude — games, maps, bonuses and board analysis via the GameFeed API, plus your games list, opponent scouting, the live board, territory picks, cards, turn planning and submission, turn notifications and chat through your signed-in war.app tab. Developed and maintained by AI (Claude Code).",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/warapp-mcp.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "warzone",
    "war.app",
    "strategy-game",
    "risk"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "warapp-mcp": "dist/bundle.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    ".mcp.json",
    "server.json",
    "manifest.json",
    "skills",
    "mint.yaml"
  ],
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "node scripts/bundle.mjs",
    "dev": "node dist/bundle.js",
    "test": "npm run typecheck && npm run lint && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run typecheck && npm run lint && vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome lint --error-on-warnings"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^3.8.1",
    "@fetchproxy/server": "^3.8.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "acorn": "^8.19.0",
    "dotenv": "^18.0.1",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
